{
  "entities": {
    "Show": {
      "title": "Show",
      "description": "Recital o concierto en Mar del Plata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "band": { "type": "string" },
        "tourName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "venue": { "type": "string" },
        "venueAddress": { "type": "string" },
        "priceFrom": { "type": "number" },
        "ticketStatus": { "type": "string" },
        "ticketUrl": { "type": "string" },
        "image": { "type": "string" },
        "genre": { "type": "string" },
        "description": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isOutdoor": { "type": "boolean" },
        "isFree": { "type": "boolean" }
      },
      "required": ["id", "band", "date", "venue"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Usuario suscrito a alertas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "instantAlerts": { "type": "boolean" },
        "weeklyDigest": { "type": "boolean" },
        "favoriteGenre": { "type": "string" },
        "subscribedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Metric": {
      "title": "Metric",
      "description": "Métricas de interacción de recitales",
      "type": "object",
      "properties": {
        "showId": { "type": "string" },
        "bandName": { "type": "string" },
        "ticketClicks": { "type": "number" },
        "shares": { "type": "number" },
        "favoritesCount": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["showId"]
    }
  },
  "firestore": {
    "/shows/{showId}": {
      "schema": "Show",
      "description": "Colección de recitales publicados"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Colección de suscriptores al newsletter y alertas"
    },
    "/metrics/{metricId}": {
      "schema": "Metric",
      "description": "Métricas y clics de entradas"
    }
  }
}
