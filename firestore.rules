rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores: se reconocen por el email de la cuenta de Firebase Authentication
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'info.mdqshow@gmail.com';
    }

    // Shows: todo el mundo los ve, solo el administrador escribe
    match /shows/{showId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sponsors: todo el mundo los ve, solo el administrador escribe
    // (ojo: lo que se escriba en el campo "Notas" de un sponsor también es visible públicamente)
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Suscriptores: el newsletter ya no existe. Nadie puede anotarse; solo el administrador
    // puede ver o borrar lo que ya hay (esta colección también sirve para comprobar el acceso de administrador).
    match /subscribers/{subscriberId} {
      allow read, write: if isAdmin();
    }

    // Métricas de shows: solo el administrador las lee. Los visitantes solo pueden sumar de a 1
    // clic o compartido, y solo sobre un show que existe.
    match /metrics/{metricId} {
      allow read: if isAdmin();

      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(
          ['showId', 'bandName', 'ticketClicks', 'shares', 'favoritesCount', 'lastUpdated'])
        && request.resource.data.showId == metricId
        && request.resource.data.bandName is string
        && request.resource.data.bandName.size() <= 200
        && request.resource.data.get('ticketClicks', 0) in [0, 1]
        && request.resource.data.get('shares', 0) in [0, 1]
        && request.resource.data.get('favoritesCount', 0) == 0
        && request.resource.data.lastUpdated is string
        && request.resource.data.lastUpdated.size() <= 40
        && exists(/databases/$(database)/documents/shows/$(metricId))
      );

      allow update: if isAdmin() || (
        request.resource.data.keys().hasOnly(
          ['showId', 'bandName', 'ticketClicks', 'shares', 'favoritesCount', 'lastUpdated'])
        && request.resource.data.showId == metricId
        && request.resource.data.bandName is string
        && request.resource.data.bandName.size() <= 200
        && (request.resource.data.get('ticketClicks', 0) - resource.data.get('ticketClicks', 0)) in [0, 1]
        && (request.resource.data.get('shares', 0) - resource.data.get('shares', 0)) in [0, 1]
        && request.resource.data.get('favoritesCount', 0) == resource.data.get('favoritesCount', 0)
        && request.resource.data.lastUpdated is string
        && request.resource.data.lastUpdated.size() <= 40
      );

      allow delete: if isAdmin();
    }

    // Métricas de banners: solo el administrador las lee. Los visitantes solo pueden sumar de a 1.
    match /banner_metrics/{bannerId} {
      allow read: if isAdmin();

      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(
          ['venueId', 'venueName', 'venueAddress', 'impressions', 'clicks', 'lastImpressionAt', 'lastClickAt'])
        && request.resource.data.venueId == bannerId
        && request.resource.data.venueName is string
        && request.resource.data.venueName.size() <= 200
        && request.resource.data.get('venueAddress', '') is string
        && request.resource.data.get('venueAddress', '').size() <= 300
        && request.resource.data.get('impressions', 0) in [0, 1]
        && request.resource.data.get('clicks', 0) in [0, 1]
        && request.resource.data.get('lastImpressionAt', '') is string
        && request.resource.data.get('lastImpressionAt', '').size() <= 40
        && request.resource.data.get('lastClickAt', '') is string
        && request.resource.data.get('lastClickAt', '').size() <= 40
      );

      allow update: if isAdmin() || (
        request.resource.data.keys().hasOnly(
          ['venueId', 'venueName', 'venueAddress', 'impressions', 'clicks', 'lastImpressionAt', 'lastClickAt'])
        && request.resource.data.venueId == bannerId
        && request.resource.data.venueName is string
        && request.resource.data.venueName.size() <= 200
        && request.resource.data.get('venueAddress', '') is string
        && request.resource.data.get('venueAddress', '').size() <= 300
        && (request.resource.data.get('impressions', 0) - resource.data.get('impressions', 0)) in [0, 1]
        && (request.resource.data.get('clicks', 0) - resource.data.get('clicks', 0)) in [0, 1]
        && request.resource.data.get('lastImpressionAt', '') is string
        && request.resource.data.get('lastImpressionAt', '').size() <= 40
        && request.resource.data.get('lastClickAt', '') is string
        && request.resource.data.get('lastClickAt', '').size() <= 40
      );

      allow delete: if isAdmin();
    }
  }
}
